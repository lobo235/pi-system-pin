{
  "name": "pi-system-pin",
  "version": "0.0.0",
  "description": "Stops pi re-reading your whole conversation when an extension's message starts a run: keeps the system block byte-identical so prefix caches hold. A stopgap for pi#5581; uninstall it once pi fixes that issue.",
  "type": "module",
  "license": "MIT",
  "author": "Justin Barlow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobo235/pi-system-pin.git"
  },
  "homepage": "https://github.com/lobo235/pi-system-pin#readme",
  "bugs": {
    "url": "https://github.com/lobo235/pi-system-pin/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "llm",
    "ai-agents",
    "prompt-cache",
    "prompt-caching",
    "system-prompt",
    "kv-cache"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/lobo235/pi-system-pin/v1.0.0/.github/assets/card.png"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-support.ts",
    "pi-compat.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && npm run load-smoke && npm run smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "load-smoke": "node load-smoke.mjs",
    "smoke": "node scripts/pi-smoke.ts",
    "check-pack": "node scripts/check-pack.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "24.19.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
