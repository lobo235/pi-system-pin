{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  // Every .ts (source, tests, scripts) is type-checked, so a new file cannot land outside the gate.
  // load-smoke.mjs is a tool, not product code: deliberately .mjs, deliberately not type-checked here.
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
